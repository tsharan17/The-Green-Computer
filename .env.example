# Copy to .env (never commit it). Real keys go only in .env or your shell.

# --- Server ---
# development (default) or production. Production never shows password-reset links in responses
# and marks the session cookie Secure.
GC_ENV=development
# SQLite for local use; PostgreSQL in production (pip install "green-computer-backend[postgres]"):
#   GC_DB_URL=postgresql+psycopg://user:password@host:5432/green_computer
GC_DB_URL=sqlite:///./green_computer.db
# Uploaded files (blob store). Default: gc_data/ next to the SQLite file.
GC_DATA_DIR=
# Public base URL, used in password-reset emails.
GC_PUBLIC_URL=http://localhost:8000
# Migrations run at start-up unless this is 0 (then run: python -m alembic upgrade head).
GC_AUTO_MIGRATE=1
# Set to 0 to close self-service sign-up.
GC_ALLOW_SIGNUP=1
GC_SESSION_DAYS=14
# Extra browser origins allowed to call the API with a session (comma-separated).
GC_ALLOWED_ORIGINS=

# --- Hosted service (see docs/deploy.md) ---
# 1 = a shared public server: rate limits and caps on, uploads capped, no model runs or INT8
# conversion on the server, and GC_SECRET_KEY + GC_AGENT_SIGNING_SECRET are required.
GC_HOSTED=0
# Upload cap in MB on a shared server (default 50 hosted, 10 in the public demo).
GC_MAX_UPLOAD_MB=

# --- File storage: local (default, under GC_DATA_DIR) or s3 (Cloudflare R2, AWS S3, MinIO) ---
GC_BLOB_BACKEND=local
GC_S3_ENDPOINT=
GC_S3_BUCKET=
GC_S3_ACCESS_KEY_ID=
GC_S3_SECRET_ACCESS_KEY=
GC_S3_REGION=auto
GC_S3_PREFIX=

# --- Email (password reset). Without it, messages go to the server log (development only). ---
GC_SMTP_HOST=
GC_SMTP_PORT=587
GC_SMTP_USER=
GC_SMTP_PASSWORD=
GC_SMTP_FROM=
GC_SMTP_STARTTLS=1

# --- Platform pricing for usage reports (leave empty for self-hosted: platform cost is zero) ---
GC_PRICE_PER_ANALYSIS=
GC_PRICE_PER_EXECUTION_MINUTE=
GC_PRICE_PER_GPU_HOUR=
GC_PRICE_PER_GB_MONTH=
GC_PRICE_CURRENCY=USD

# --- Local execution (always available on CPU) ---
# Optional GPU backends: only used when ONNX Runtime provides them AND these are set.
GC_ENABLE_CUDA=0
GC_ENABLE_TENSORRT=0
# Wall-clock limit for one timed run, seconds; threads for ONNX Runtime (0 = runtime default).
GC_EXEC_MAX_SECONDS=120
GC_EXEC_THREADS=0

# --- Secrets the server creates for itself (set them to manage them yourself; never commit them) ---
# Seals authenticator secrets and signs short sign-in steps. Default: <data dir>/server.key (created once).
GC_SECRET_KEY=
# Signs device-agent requests. Default: <data dir>/agent_signing.key. Changing it means re-pairing devices.
GC_AGENT_SIGNING_SECRET=

# --- Accounts ---
# 1 = an account must confirm its email before it can change anything (needs working SMTP).
GC_REQUIRE_EMAIL_VERIFICATION=0
# Trust X-Forwarded-For for client addresses (only behind your own reverse proxy).
GC_TRUST_PROXY=0

# --- Rate limiting: memory (one process) | database (shared by all workers) | auto (database on PostgreSQL) ---
GC_RATE_LIMIT_BACKEND=auto

# --- Observability ---
GC_LOG_FORMAT=text          # json for log shippers
GC_LOG_LEVEL=INFO
GC_LOG_IPS=0                # 1 adds client addresses to request logs
GC_METRICS_TOKEN=           # set to enable GET /metrics (Prometheus) for this bearer token
GC_ERROR_REPORTER=log       # log | webhook | sentry
GC_ERROR_WEBHOOK_URL=       # your own endpoint for scrubbed error reports
GC_SENTRY_DSN=              # only with GC_ERROR_REPORTER=sentry and `pip install sentry-sdk`
GC_GIT_SHA=                 # recorded in reproducibility manifests when .git is not deployed

# --- Telemetry: off. Nothing is sent unless both are set; preview with scripts/telemetry.py ---
GC_TELEMETRY=0
GC_TELEMETRY_URL=
