# Copy to .env (never commit it). Real keys go only in .env or your shell.

# --- Nebius Token Factory (Nemotron). Required for the Green Agent. ---
TOKEN_FACTORY_API_KEY=
# Optional: defaults to https://api.tokenfactory.nebius.com/v1/ (any OpenAI-compatible endpoint works)
TOKEN_FACTORY_BASE_URL=
# Optional model ids; the app lists the provider's models and matches by name if these are wrong.
GC_MODEL_ULTRA=
GC_MODEL_SUPER=
GC_MODEL_NANO=

# --- Nebius Serverless Jobs (real GPU benchmarks). Needs the `nebius` CLI installed and logged in. ---
NEBIUS_PROJECT_ID=
# GPU platform per device is set in the device YAML; override here if your region differs, e.g. gpu-l40s-d
GC_NEBIUS_PLATFORM_OVERRIDE=
GC_NEBIUS_PRESET_OVERRIDE=
# Container image that has CUDA + Python (the job installs onnxruntime-gpu at start-up)
GC_BENCH_IMAGE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# --- Local ---
GC_DB_URL=sqlite:///./green_computer.db
